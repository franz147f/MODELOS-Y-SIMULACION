{UTF-8}
Peticiones pendientes = INTEG(Arribos - Atenciones - Abandonos, 0)
	~ peticiones
	~ Stock de solicitudes sin finalizar.
	|
Capacidad operativa = INTEG(Ampliacion - Obsolescencia, Capacidad inicial)
	~ peticiones/hora
	~ Stock de capacidad de servicio, medido en peticiones por hora.
	|
Arribos = Demanda
	~ peticiones/hora
	~ Ingreso continuo de solicitudes.
	|
Demanda = Demanda base * IF THEN ELSE( (Time >= Inicio pico) :AND: (Time < Fin pico),
 IF THEN ELSE(Activar pico = 1, Factor pico, 1), 1)
	~ peticiones/hora
	~ Demanda por tramos en el intervalo de pico.
	|
Presion = Arribos/MAX(1, Capacidad operativa) +
 Peticiones pendientes/(MAX(1, Capacidad operativa)*Horizonte cola)
	~ dmnl
	~ Presion de demanda y cola sobre la capacidad operativa.
	|
Eficiencia = 1/(1 + Degradacion * MAX(0, Presion - 1))
	~ dmnl
	~ Factor de rendimiento que disminuye ante la saturacion.
	|
Capacidad efectiva = Capacidad operativa * Eficiencia
	~ peticiones/hora
	~ Capacidad util despues de considerar congestion.
	|
Atenciones = MIN(Capacidad efectiva, Arribos + Peticiones pendientes/TIME STEP)
	~ peticiones/hora
	~ Atenciones limitadas por la capacidad y solicitudes disponibles.
	|
Abandonos = MIN(Peticiones pendientes/Tiempo abandono,
 MAX(0, Arribos + Peticiones pendientes/TIME STEP - Atenciones))
	~ peticiones/hora
	~ Salidas de la cola por espera excesiva.
	|
Ampliacion = IF THEN ELSE(Activar ampliacion = 1,
 MIN(Max ampliacion, Ganancia inversion*MAX(0, Presion - 1)), 0)
	~ peticiones/hora/hora
	~ Incorporacion de capacidad en respuesta a la presion.
	|
Obsolescencia = Capacidad operativa*Tasa obsolescencia
	~ peticiones/hora/hora
	~ Disminucion gradual de capacidad.
	|
Demanda base = 30
	~ peticiones/hora
	~ Tasa nominal recuperada del caso del Laboratorio 2.
	|
Capacidad inicial = 36
	~ peticiones/hora
	~ Supuesto inicial de capacidad, no medido.
	|
Activar pico = 1
	~ dmnl
	~ Valor 0 para el escenario base y 1 para escenario de pico.
	|
Activar ampliacion = 1
	~ dmnl
	~ Valor 0 para no ampliar y 1 para habilitar la politica adaptativa.
	|
Inicio pico = 12
	~ hora
	~ Comienzo del pico de demanda.
	|
Fin pico = 30
	~ hora
	~ Fin del pico de demanda.
	|
Factor pico = 2.2
	~ dmnl
	~ Multiplicador de demanda durante el pico.
	|
Horizonte cola = 4
	~ hora
	~ Escala temporal para contribucion de cola a presion.
	|
Tiempo abandono = 4
	~ hora
	~ Tiempo medio modelado para el abandono de solicitudes en cola.
	|
Degradacion = 0.08
	~ dmnl
	~ Penalizacion fraccional por presion excedente.
	|
Tasa obsolescencia = 0.002
	~ 1/hora
	~ Fraccion de capacidad perdida por hora.
	|
Ganancia inversion = 10
	~ peticiones/hora/hora
	~ Respuesta de ampliacion a presion.
	|
Max ampliacion = 8
	~ peticiones/hora/hora
	~ Limite de ampliacion por hora.
	|
********************************************************
	.Control
********************************************************~
	Simulation Control Parameters
	|
FINAL TIME = 48
	~ hora
	~ Horizonte total de simulacion.
	|
INITIAL TIME = 0
	~ hora
	~ Inicio.
	|
TIME STEP = 0.05
	~ hora
	~ Metodo de Euler, paso 0.05 h.
	|
SAVEPER = TIME STEP
	~ hora
	~ Guarda en cada paso.
	|
